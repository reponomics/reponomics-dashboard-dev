name: Preserve Reponomics traffic artifact on outage

on:
  workflow_run:
    workflows: ["Collect Reponomics traffic"]
    types: [completed]
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read

env:
  OUTAGE_RETENTION_DAYS: "90"

jobs:
  preserve:
    if: >-
      (github.event_name == 'workflow_dispatch' && github.ref == 'refs/heads/main') ||
      (github.event_name == 'workflow_run' && github.event.workflow_run.conclusion == 'failure')
    runs-on: ubuntu-latest
    permissions:
      contents: read
      actions: write

    steps:
      - name: Resolve source artifact
        id: source
        env:
          GITHUB_TOKEN: ${{ github.token }}
          SOURCE_RUN_ID: ${{ github.event.workflow_run.id || '' }}
        run: |
          set -euo pipefail
          python - <<'PY'
          import json
          import os
          import sys
          import urllib.request

          repo = os.environ["GITHUB_REPOSITORY"]
          token = os.environ["GITHUB_TOKEN"]
          source_run_id = os.environ.get("SOURCE_RUN_ID", "").strip()
          api_base = f"https://api.github.com/repos/{repo}"
          headers = {
              "Accept": "application/vnd.github+json",
              "Authorization": f"Bearer {token}",
              "X-GitHub-Api-Version": "2022-11-28",
              "User-Agent": "reponomics-incident-sentinel",
          }

          def fetch_json(url: str) -> dict:
              request = urllib.request.Request(url, headers=headers)
              with urllib.request.urlopen(request, timeout=30) as response:
                  payload = response.read().decode("utf-8")
              return json.loads(payload)

          candidates: list[dict] = []

          if source_run_id:
              payload = fetch_json(
                  f"{api_base}/actions/runs/{source_run_id}/artifacts?name=traffic-data&per_page=100"
              )
              candidates.extend(payload.get("artifacts", []))

          if not candidates:
              page = 1
              while True:
                  payload = fetch_json(
                      f"{api_base}/actions/artifacts?name=traffic-data&per_page=100&page={page}"
                  )
                  rows = payload.get("artifacts", [])
                  if not rows:
                      break
                  candidates.extend(rows)
                  if len(rows) < 100:
                      break
                  page += 1

          eligible: list[dict] = []
          for artifact in candidates:
              if artifact.get("expired"):
                  continue
              workflow_run = artifact.get("workflow_run") or {}
              head_branch = workflow_run.get("head_branch")
              if head_branch and head_branch != "main":
                  continue
              eligible.append(artifact)

          eligible.sort(key=lambda row: row.get("created_at", ""), reverse=True)
          output_path = os.environ["GITHUB_OUTPUT"]
          summary_path = os.environ.get("GITHUB_STEP_SUMMARY")

          if not eligible:
              with open(output_path, "a", encoding="utf-8") as handle:
                  handle.write("found=false\n")
              if summary_path:
                  with open(summary_path, "a", encoding="utf-8") as handle:
                      handle.write(
                          "## Outage sentinel\n\n"
                          "No unexpired `traffic-data` artifact was found to preserve.\n"
                      )
              print("No unexpired traffic-data artifact available for preservation.")
              sys.exit(0)

          chosen = eligible[0]
          artifact_id = chosen["id"]
          workflow_run = chosen.get("workflow_run") or {}
          run_id = workflow_run.get("id", "")
          download_url = chosen["archive_download_url"]
          expires_at = chosen.get("expires_at", "")

          with open(output_path, "a", encoding="utf-8") as handle:
              handle.write("found=true\n")
              handle.write(f"artifact_id={artifact_id}\n")
              handle.write(f"run_id={run_id}\n")
              handle.write(f"download_url={download_url}\n")
              handle.write(f"expires_at={expires_at}\n")

          if summary_path:
              with open(summary_path, "a", encoding="utf-8") as handle:
                  handle.write(
                      "## Outage sentinel\n\n"
                      f"Selected artifact `{artifact_id}` from workflow run `{run_id}`"
                      f" (expires `{expires_at}`).\n"
                  )

          print(
              f"Selected artifact {artifact_id} from run {run_id or 'unknown'} "
              f"(expires {expires_at or 'unknown'})."
          )
          PY

      - name: Download selected artifact archive
        if: ${{ steps.source.outputs.found == 'true' }}
        env:
          GITHUB_TOKEN: ${{ github.token }}
          DOWNLOAD_URL: ${{ steps.source.outputs.download_url }}
        run: |
          set -euo pipefail
          mkdir -p .sentinel
          python - <<'PY'
          import os
          import urllib.request
          from pathlib import Path

          token = os.environ["GITHUB_TOKEN"]
          url = os.environ["DOWNLOAD_URL"]
          destination = Path(".sentinel") / "traffic-data.zip"
          request = urllib.request.Request(
              url,
              headers={
                  "Accept": "application/vnd.github+json",
                  "Authorization": f"Bearer {token}",
                  "X-GitHub-Api-Version": "2022-11-28",
                  "User-Agent": "reponomics-incident-sentinel",
              },
          )
          with urllib.request.urlopen(request, timeout=60) as response:
              destination.write_bytes(response.read())
          print(f"Downloaded source artifact to {destination}")
          PY

      - name: Extract selected artifact payload
        if: ${{ steps.source.outputs.found == 'true' }}
        run: |
          set -euo pipefail
          mkdir -p .sentinel/traffic-data
          unzip -o .sentinel/traffic-data.zip -d .sentinel/traffic-data >/dev/null
          ls -la .sentinel/traffic-data

      - name: Upload preserved traffic artifact
        if: ${{ steps.source.outputs.found == 'true' }}
        uses: actions/upload-artifact@v4
        with:
          name: traffic-data
          path: .sentinel/traffic-data
          retention-days: ${{ env.OUTAGE_RETENTION_DAYS }}
          overwrite: true

      - name: Write preservation summary
        if: ${{ steps.source.outputs.found == 'true' }}
        run: |
          {
            echo "## Outage sentinel"
            echo
            echo "Preserved \`traffic-data\` from run \`${{ steps.source.outputs.run_id }}\`."
            echo "New retention: \`${{ env.OUTAGE_RETENTION_DAYS }}\` day(s)."
          } >> "$GITHUB_STEP_SUMMARY"
